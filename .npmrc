# Supply-chain rule for the dev tooling (the extension itself has no dependencies):
# resolve every package, including transitive ones, as published on or before this date,
# which must stay at least 4 weeks in the past. Raise it deliberately, then run `npm audit`.
before=2026-09-24
save-exact=true
fund=false
# No install scripts from dependencies (only @vscode/vsce-sign has one, copying a signing
# binary that packaging does not use). Scripts of this package still run with `npm run`.
ignore-scripts=true
